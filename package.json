{
  "name": "velotradex",
  "version": "1.0.0",
  "main": "index.js",
  "author": "VeloTradeX",
  "license": "MIT",
  "scripts": {
    "build": "npm run build:version && tsc",
    "build:version": "node scripts/generate-version.js",
    "start": "node dist/app.js",
    "dev": "NODE_ENV=development nodemon --exec ts-node src/app.ts",
    "prod": "npm run build && pm2 start ecosystem.config.js",
    "signer:build": "./tools/lighter-signer/build.sh",
    "test": "npm run test:unit",
    "test:watch": "npm run test:unit:watch",
    "test:coverage": "npm run test:unit:coverage",
    "test:unit": "jest",
    "test:unit:watch": "jest --watch",
    "test:unit:coverage": "jest --coverage",
    "test:e2e": "jest --config jest.e2e.config.js",
    "test:e2e:watch": "jest --config jest.e2e.config.js --watch",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:migrate:undo:all": "sequelize-cli db:migrate:undo:all",
    "db:migrate:status": "sequelize-cli db:migrate:status",
    "db:migration:generate": "sequelize-cli migration:generate --name",
    "db:seed": "sequelize-cli db:seed:all",
    "db:seed:undo": "sequelize-cli db:seed:undo",
    "db:seed:undo:all": "sequelize-cli db:seed:undo:all",
    "markets:cfd": "npx tsx scripts/update-gate-cfd-markets-from-api.ts",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"**/*.{ts,js,json,cjs,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,cjs}\""
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@koa/multer": "^4.0.0",
    "@types/json-bigint": "^1.0.4",
    "@types/ws": "^8.18.1",
    "adm-zip": "^0.5.16",
    "axios": "^1.13.2",
    "bcryptjs": "^3.0.3",
    "commander": "^14.0.2",
    "debug": "^4.4.3",
    "dotenv": "^17.2.3",
    "gate-api": "^7.2.100",
    "https-proxy-agent": "^7.0.6",
    "ioredis": "^5.9.0",
    "json-bigint": "^1.0.0",
    "jsonwebtoken": "^9.0.3",
    "koa": "^3.1.1",
    "koa-bodyparser": "^4.4.1",
    "koa-router": "^14.0.0",
    "koa-static": "^5.0.0",
    "multer": "^2.0.2",
    "sequelize": "^6.37.7",
    "sqlite3": "^5.1.7",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "ws": "^8.19.0",
    "xlsx": "^0.18.5",
    "xlsx-js-style": "^1.2.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/bcryptjs": "^3.0.0",
    "@types/debug": "^4.1.12",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/koa": "^3.0.1",
    "@types/koa-bodyparser": "^4.3.13",
    "@types/koa-router": "^7.4.9",
    "@types/koa-static": "^4.0.4",
    "@types/koa__multer": "^2.0.8",
    "@types/multer": "^2.0.0",
    "@types/node": "^25.0.3",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.46.1",
    "@typescript-eslint/parser": "^8.46.1",
    "eslint": "^9.39.2",
    "jest": "^30.3.0",
    "nodemon": "^3.1.11",
    "pm2": "^6.0.14",
    "prettier": "^3.6.1",
    "sequelize-cli": "^6.6.5",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
