# Environment Loading
# APP_ENV controls optional .env.<APP_ENV> loading before .env.
# Default: development, so .env.development is loaded first if it exists.
APP_ENV=development

# Docker 镜像来源（仅 docker compose 读取，用于变量插值；不配则用 ghcr.io 默认值）
# 注意两边的 tag 拼法不同：
#   GHCR 镜像仓库      → semver 不带 v，用 1.0.0
#   Release 离线包    → 载入后的镜像名是 velotradex:v1.0.0（带 v）
# VTX_IMAGE=ghcr.io/velotradex/velotradex
# VTX_TAG=1.0.0
#
# 用 Release 离线包时：
#   VTX_IMAGE=velotradex
#   VTX_TAG=v1.0.0

# Server Configuration
# 注意：SERVER_PORT 必须与 docker-compose.yml 的端口映射/健康检查保持一致（容器部署下
# compose 会强制覆写为 3000）；本地开发可以改成其它值以避开端口占用。
SERVER_PORT=3000
# 必须替换为高强度随机值：仍为占位符时服务会打印 FATAL 并直接退出（测试环境除外）。
# 生成方式：node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SERVER_JWT_SECRET=change_me_to_a_long_random_secret
SERVER_JWT_EXPIRES_IN=24h
# Refresh token 独立有效期（滑动续期，每次刷新后重置计时）。留空则回退为 access 的 10 倍。
SERVER_JWT_REFRESH_EXPIRES_IN=240h
# 会话绝对上限：即使一直活跃，超过该时长也强制重新登录（0 或空 = 不限制）。
SERVER_JWT_SESSION_MAX=30d
SERVER_ENABLE_API_AUDIT=true

# Initial admin account (created automatically at first startup when set).
# If empty/unset, no default admin is created — create a user via the API instead.
# Change it immediately after first login.
ADMIN_DEFAULT_PASSWORD=

# Field-level secret encryption (REQUIRED for production with real funds)
# SERVER_ENCRYPTION_KEY enables AES-256-GCM encryption-at-rest for exchange
# API keys/secrets and AI API keys stored in the database.
# - Set it to a long random passphrase, e.g.: openssl rand -hex 32
# - When set, encrypted on write, decrypted on read (backward compatible via the
#   `enc:v1:` prefix; existing plaintext rows keep working).
# - When EMPTY/unset, secrets are stored in plaintext (a security warning is
#   printed once at startup). For real-money trading you MUST set this.
# - WARNING: if you change it later, previously encrypted secrets cannot be
#   decrypted. Back up the value.
SERVER_ENCRYPTION_KEY=

# Redis Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_MSG_CHANNEL=discord:msg

# Database Configuration
DB_STORAGE=./data/velotradex.db
DB_LOGGING=false

# Trading Configuration
# mode: real | testnet | observe
TRADING_MODE=observe

# Proxy Configuration
# TRADING_API_PROXY is used by Gate.io REST requests.
# TRADING_WS_PROXY is loaded into app config, but exchange instances currently use
# their DB-stored "proxy" field for WebSocket connections.
# If TRADING_API_PROXY/TRADING_WS_PROXY are empty, ALL_PROXY/HTTPS_PROXY/HTTP_PROXY
# are used as fallback for both app config fields.
#
# ⚠️ 容器部署注意：容器内的 127.0.0.1 指向容器自身，而不是宿主机。
# 若这里填 http://127.0.0.1:7890，进入 Docker 后交易所 REST/WS 会全部连接失败。
# docker-compose.yml 已默认清空这些变量；确需经宿主代理出网时，请在
# docker-compose.override.yml 中改为 http://host.docker.internal:7890。
TRADING_API_PROXY=
TRADING_WS_PROXY=
ALL_PROXY=
HTTPS_PROXY=
HTTP_PROXY=

# Default Position Configuration
DEFAULT_POSITION_LEVERAGE=10
DEFAULT_POSITION_MARGIN_TYPE=cross
DEFAULT_POSITION_POSITION_MODE=one-way

# Execution Configuration (Padding ratios)
TRADING_EXECUTION_DEFAULT_PADDING_R_ENTRY=0.01
TRADING_EXECUTION_DEFAULT_PADDING_R_TP=0.01
TRADING_EXECUTION_DEFAULT_PADDING_R_SL=0.01

# Logging
LOG_LEVEL=info

# Frontend dev proxy (admin-web/vite.config.ts)
# Used only when running the admin-web Vite dev server.
CLOUD_URL=http://localhost:3000

# Exchange Credentials (optional)
# Gate.io real account credentials (used in TRADING_MODE=real)
TRADING_GATE_REAL_API_KEY=
TRADING_GATE_REAL_API_SECRET=

# Gate.io testnet account credentials (used in TRADING_MODE=testnet)
TRADING_GATE_TESTNET_API_KEY=
TRADING_GATE_TESTNET_API_SECRET=

# Gate.io TraDFI account credentials
TRADING_GATE_TRADFI_API_KEY=
TRADING_GATE_TRADFI_API_SECRET=

# DeepCoin account credentials
DEEPCOIN_API_KEY=
DEEPCOIN_API_SECRET=
DEEPCOIN_PASSPHRASE=

# Optional: field-level encryption key for exchange/AI credentials.
# NOTE: 当前为建议方向，具体以代码实现为准（若你的版本未实现该能力，请忽略此项）。
# SERVER_ENCRYPTION_KEY=
