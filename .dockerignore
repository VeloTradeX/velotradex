# 依赖
# 注意：.dockerignore 的模式按「完整相对路径」匹配，顶层的 node_modules/ 不会
# 排除 admin-web/node_modules，必须显式列出，否则每次构建都会多传 390MB+ 上下文。
node_modules/
admin-web/node_modules/

# 构建产物
# 同理，以下各条也只作用于仓库顶层；admin-web/dist 需单独排除
# （前端在容器内的 web-builder 阶段重新构建）。
dist/
build/
bin/
admin-web/dist/

# 版本控制
.git/
.gitignore

# 数据（SQLite 文件库，通过 volume 挂载）
data/
*.sqlite
*.db

# 日志
logs/
*.log
npm-debug.log*
yarn-debug.log*

# 环境变量与密钥（重要：禁止打入镜像）
.env
.env.*.local
.env.development

# 测试与覆盖率
coverage/
tmp/

# Lighter 签名工具的 Python 虚拟环境 / 本地二进制（Go 二进制需单独构建挂载）
tools/*/.venv/
tools/lighter-signer/build.sh

# 编辑器 / 系统
.DS_Store
.idea/
.vscode/
*.swp